# Gemini API key (chat model + embeddings)
GOOGLE_API_KEY=

# HuggingFace token (used by local R&D notebooks/embeddings, not required by app.py)
HF_TOKEN=

# Supabase Postgres connection string (Session pooler or direct connection),
# e.g. postgresql://postgres:[password]@[host]:5432/postgres
SUPABASE_DB_URL=

# Default passwords new accounts are created with, per role (see
# implementation/accounts.py). Must differ: anyone who knows the worker password
# must not be able to sign in as an admin. The app refuses to start without both.
# Each account stores its own hash, so changing these later only affects accounts
# created or reset afterwards.
WORKER_DEFAULT_PASSWORD=
ADMIN_DEFAULT_PASSWORD=

# Optional rate-limit overrides (defaults shown; 0 disables a window). See
# implementation/rate_limit.py and the README's rate-limit table.
# RATE_LIMIT_WORKER_PER_MINUTE=5
# RATE_LIMIT_WORKER_PER_HOUR=60
# RATE_LIMIT_WORKER_PER_DAY=300
# RATE_LIMIT_ADMIN_PER_MINUTE=10
# RATE_LIMIT_ADMIN_PER_HOUR=0
# RATE_LIMIT_ADMIN_PER_DAY=0
# RATE_LIMIT_GLOBAL_PER_DAY=3000
# RATE_LIMIT_LOGIN_PER_IP=10
# RATE_LIMIT_LOGIN_IP_WINDOW_SECONDS=300
# LOGIN_MAX_FAILURES=5
# LOGIN_LOCKOUT_SECONDS=900
# RATE_LIMIT_FEEDBACK_PER_MINUTE=30
# RATE_LIMIT_ADMIN_ACTIONS_PER_MINUTE=30
# RATE_LIMIT_ACCOUNTS_PER_HOUR=50
# MAX_QUESTION_CHARS=1500
# MAX_HISTORY_MESSAGES=10
